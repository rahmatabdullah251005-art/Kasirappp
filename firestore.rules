rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@\\.]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function storeExists(storeId) {
      return exists(/databases/$(database)/documents/stores/$(storeId));
    }

    function isStoreOwner(storeId) {
      return isSignedIn() &&
             storeExists(storeId) &&
             get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }

    function isActiveStoreMember(storeId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data.isActive == true;
    }

    function isVerifiedEmailMatching(targetEmail) {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email is string &&
             request.auth.token.email.lower() == targetEmail.lower();
    }

    // --- ENTITY VALIDATORS ---
    function isValidStore(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
             data.qrisPayload is string && data.qrisPayload.size() >= 1 && data.qrisPayload.size() <= 1024 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStoreMember(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.storeId is string && data.storeId.size() >= 1 && data.storeId.size() <= 128 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('inviteId' in data) || (data.inviteId is string && data.inviteId.size() <= 128)) &&
             data.role in ['OWNER', 'KASIR'] &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStoreInvite(data) {
      return data.storeId is string && data.storeId.size() >= 1 && data.storeId.size() <= 128 &&
             data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.cashierEmail is string && data.cashierEmail.size() >= 3 && data.cashierEmail.size() <= 160 &&
             data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 80 &&
             data.status in ['pending', 'accepted'] &&
             (!('acceptedUid' in data) || (data.acceptedUid is string && data.acceptedUid.size() <= 128)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStaffPinProfile(data) {
      return data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
             data.role in ['OWNER', 'KASIR'] &&
             data.pinHash is string && data.pinHash.size() == 64 &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStoreCategory(data) {
      return data.code is string && data.code.size() >= 1 && data.code.size() <= 60 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.codePrefix is string && data.codePrefix.size() >= 1 && data.codePrefix.size() <= 8 &&
             data.colorIndex is int && data.colorIndex >= 0 && data.colorIndex <= 20 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidProduct(data) {
      return data.skuCode is string && data.skuCode.size() >= 1 && data.skuCode.size() <= 80 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             (!('variantInfo' in data) || (data.variantInfo is string && data.variantInfo.size() <= 160)) &&
             (!('variantName' in data) || (data.variantName is string && data.variantName.size() <= 80)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 60)) &&
             (!('size' in data) || (data.size is string && data.size.size() <= 60)) &&
             data.costPrice is int && data.costPrice >= 0 &&
             data.sellingPrice is int && data.sellingPrice >= 0 &&
             (!('discountPercent' in data) || (data.discountPercent is int && data.discountPercent >= 0 && data.discountPercent <= 99)) &&
             data.stock is int && data.stock >= 0 &&
             data.minStockAlert is int && data.minStockAlert >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSaleTransaction(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() >= 4 && data.invoiceNumber.size() <= 60 &&
             data.timestampMillis is int && data.timestampMillis > 0 &&
             data.dateKey is string && data.dateKey.size() == 10 &&
             data.totalItems is int && data.totalItems > 0 &&
             data.totalRevenue is int && data.totalRevenue >= 0 &&
             data.discountAmount is int && data.discountAmount >= 0 &&
             data.finalRevenue is int && data.finalRevenue >= 0 &&
             data.totalCost is int && data.totalCost >= 0 &&
             data.netProfit is int &&
             data.paymentMethod in ['TUNAI', 'QRIS', 'TRANSFER'] &&
             data.amountPaid is int && data.amountPaid >= 0 &&
             data.changeAmount is int && data.changeAmount >= 0 &&
             data.cashierUid is string && data.cashierUid.size() >= 1 && data.cashierUid.size() <= 128 &&
             data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 80 &&
             data.cashierRole in ['OWNER', 'KASIR'] &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 80)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             (!('qrisReference' in data) || (data.qrisReference is string && data.qrisReference.size() <= 512)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidSaleItem(data) {
      return data.transactionId is string && data.transactionId.size() >= 1 && data.transactionId.size() <= 128 &&
             data.dateKey is string && data.dateKey.size() == 10 &&
             data.timestampMillis is int && data.timestampMillis > 0 &&
             data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
             data.skuCode is string && data.skuCode.size() >= 1 && data.skuCode.size() <= 80 &&
             data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120 &&
             (!('variantSummary' in data) || (data.variantSummary is string && data.variantSummary.size() <= 160)) &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 60 &&
             data.quantity is int && data.quantity > 0 &&
             data.unitCostPrice is int && data.unitCostPrice >= 0 &&
             data.unitSellingPrice is int && data.unitSellingPrice >= 0 &&
             data.subtotalRevenue is int && data.subtotalRevenue >= 0 &&
             data.subtotalCost is int && data.subtotalCost >= 0 &&
             data.subtotalProfit is int &&
             data.cashierUid is string && data.cashierUid.size() >= 1 && data.cashierUid.size() <= 128 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidStockHistory(data) {
      return data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
             data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120 &&
             data.changeType in ['PRODUK_BARU', 'RESTOK', 'PENJUALAN', 'KOREKSI'] &&
             data.quantityDelta is int &&
             data.stockAfter is int && data.stockAfter >= 0 &&
             data.unitCostAtChange is int && data.unitCostAtChange >= 0 &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 80 &&
             data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
             data.timestampMillis is int && data.timestampMillis > 0 &&
             isValidTimestamp(data.createdAt);
    }

    // --- COLLECTION RULES ---

    // Store Invites (top-level so invited cashiers can discover invitations by verified email or acceptedUid)
    match /store_invites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        existing().ownerUid == request.auth.uid ||
        existing().acceptedUid == request.auth.uid ||
        isVerifiedEmailMatching(existing().cashierEmail)
      );
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.acceptedUid == request.auth.uid ||
        isVerifiedEmailMatching(resource.data.cashierEmail)
      );
      allow create: if isSignedIn() &&
                       isValidId(inviteId) &&
                       incoming().ownerUid == request.auth.uid &&
                       isStoreOwner(incoming().storeId) &&
                       incoming().status == 'pending' &&
                       incoming().keys().hasAll(['storeId', 'storeName', 'ownerUid', 'cashierEmail', 'cashierName', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['storeId', 'storeName', 'ownerUid', 'cashierEmail', 'cashierName', 'status', 'acceptedUid', 'createdAt', 'updatedAt']) &&
                       isValidStoreInvite(incoming());
      allow update: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isValidStoreInvite(incoming()) &&
                       incoming().storeId == existing().storeId &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt && (
                         // Owner can manage invite
                         (existing().ownerUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['cashierName', 'status', 'updatedAt'])) ||
                         // Invited cashier with verified email can accept pending invite once
                         (existing().status == 'pending' &&
                          isVerifiedEmailMatching(existing().cashierEmail) &&
                          incoming().status == 'accepted' &&
                          incoming().acceptedUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedUid', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(inviteId) && existing().ownerUid == request.auth.uid;
    }

    // Stores Root Document
    match /stores/{storeId} {
      allow get: if isSignedIn() && isValidId(storeId) && (
        existing().ownerUid == request.auth.uid ||
        isActiveStoreMember(storeId)
      );
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(storeId) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().keys().hasAll(['ownerUid', 'storeName', 'qrisPayload', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerUid', 'storeName', 'qrisPayload', 'createdAt', 'updatedAt']) &&
                       isValidStore(incoming());
      allow update: if isSignedIn() &&
                       isValidId(storeId) &&
                       existing().ownerUid == request.auth.uid &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       isValidStore(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['storeName', 'qrisPayload', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(storeId) && existing().ownerUid == request.auth.uid;

      // Store Members subcollection
      match /members/{memberUid} {
        allow get: if isSignedIn() && isValidId(memberUid) && (
          request.auth.uid == memberUid ||
          isStoreOwner(storeId)
        );
        allow list: if isStoreOwner(storeId);
        allow create: if isSignedIn() &&
                         isValidId(memberUid) &&
                         incoming().uid == memberUid &&
                         incoming().storeId == storeId &&
                         incoming().keys().hasAll(['uid', 'storeId', 'ownerUid', 'storeName', 'fullName', 'role', 'isActive', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['uid', 'storeId', 'ownerUid', 'storeName', 'fullName', 'email', 'inviteId', 'role', 'isActive', 'createdAt', 'updatedAt']) &&
                         isValidStoreMember(incoming()) && (
                           // Owner registers themselves as OWNER member
                           (request.auth.uid == memberUid &&
                            incoming().role == 'OWNER' &&
                            incoming().isActive == true &&
                            isStoreOwner(storeId)) ||
                           // Owner adds a member directly
                           (isStoreOwner(storeId) && incoming().ownerUid == request.auth.uid) ||
                           // Invited cashier joins as KASIR via matching verified invite
                           (request.auth.uid == memberUid &&
                            incoming().role == 'KASIR' &&
                            incoming().isActive == true &&
                            ('inviteId' in incoming()) &&
                            isValidId(incoming().inviteId) &&
                            exists(/databases/$(database)/documents/store_invites/$(incoming().inviteId)) &&
                            get(/databases/$(database)/documents/store_invites/$(incoming().inviteId)).data.storeId == storeId &&
                            get(/databases/$(database)/documents/store_invites/$(incoming().inviteId)).data.ownerUid == incoming().ownerUid &&
                            isVerifiedEmailMatching(get(/databases/$(database)/documents/store_invites/$(incoming().inviteId)).data.cashierEmail))
                         );
        allow update: if isStoreOwner(storeId) &&
                         isValidId(memberUid) &&
                         isValidStoreMember(incoming()) &&
                         incoming().uid == existing().uid &&
                         incoming().storeId == existing().storeId &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'isActive', 'updatedAt']);
        allow delete: if isStoreOwner(storeId) && isValidId(memberUid) && memberUid != request.auth.uid;
      }

      // Store PIN Profiles (Owner & Kasir PIN separation)
      match /staff_pins/{staffId} {
        allow get: if isValidId(staffId) && (isStoreOwner(storeId) || isActiveStoreMember(storeId));
        allow list: if isStoreOwner(storeId) || isActiveStoreMember(storeId);
        allow create: if isStoreOwner(storeId) &&
                         isValidId(staffId) &&
                         incoming().keys().hasAll(['username', 'fullName', 'role', 'pinHash', 'isActive', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['username', 'fullName', 'role', 'pinHash', 'isActive', 'createdAt', 'updatedAt']) &&
                         isValidStaffPinProfile(incoming());
        allow update: if isStoreOwner(storeId) &&
                         isValidId(staffId) &&
                         isValidStaffPinProfile(incoming()) &&
                         incoming().username == existing().username &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'pinHash', 'isActive', 'updatedAt']);
        allow delete: if isStoreOwner(storeId) && isValidId(staffId) && existing().role != 'OWNER';
      }

      // Store Categories (Owner adds/edits/deletes; Kasir & Owner read)
      match /categories/{categoryId} {
        allow get: if isValidId(categoryId) && (isStoreOwner(storeId) || isActiveStoreMember(storeId));
        allow list: if isStoreOwner(storeId) || isActiveStoreMember(storeId);
        allow create: if isStoreOwner(storeId) &&
                         isValidId(categoryId) &&
                         incoming().keys().hasAll(['code', 'displayName', 'codePrefix', 'colorIndex', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['code', 'displayName', 'codePrefix', 'colorIndex', 'createdAt', 'updatedAt']) &&
                         isValidStoreCategory(incoming());
        allow update: if isStoreOwner(storeId) &&
                         isValidId(categoryId) &&
                         isValidStoreCategory(incoming()) &&
                         incoming().code == existing().code &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'codePrefix', 'colorIndex', 'updatedAt']);
        allow delete: if isStoreOwner(storeId) && isValidId(categoryId);
      }

      // Store Products (Owner manages full CRUD & modal; Kasir reads catalog and adjusts stock on sale or stock opname)
      match /products/{productId} {
        allow get: if isValidId(productId) && (isStoreOwner(storeId) || isActiveStoreMember(storeId));
        allow list: if isStoreOwner(storeId) || isActiveStoreMember(storeId);
        allow create: if isStoreOwner(storeId) &&
                         isValidId(productId) &&
                         incoming().keys().hasAll(['skuCode', 'name', 'category', 'costPrice', 'sellingPrice', 'stock', 'minStockAlert', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['skuCode', 'name', 'category', 'variantInfo', 'variantName', 'color', 'size', 'costPrice', 'sellingPrice', 'discountPercent', 'stock', 'minStockAlert', 'createdAt', 'updatedAt']) &&
                         isValidProduct(incoming());
        allow update: if isValidId(productId) &&
                         isValidProduct(incoming()) &&
                         incoming().createdAt == existing().createdAt && (
                           // Owner can update all mutable fields
                           (isStoreOwner(storeId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['skuCode', 'name', 'category', 'variantInfo', 'variantName', 'color', 'size', 'costPrice', 'sellingPrice', 'discountPercent', 'stock', 'minStockAlert', 'updatedAt'])) ||
                           // Active Cashier can ONLY adjust stock (cannot change costPrice, sellingPrice, or metadata)
                           (isActiveStoreMember(storeId) &&
                            incoming().stock != existing().stock &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt']))
                         );
        allow delete: if isStoreOwner(storeId) && isValidId(productId);
      }

      // Store Transactions (Append-only ledger; Owner reads all, Kasir reads only own shift transactions)
      match /transactions/{transactionId} {
        allow get: if isValidId(transactionId) && (
          isStoreOwner(storeId) ||
          (isActiveStoreMember(storeId) && existing().cashierUid == request.auth.uid)
        );
        allow list: if isStoreOwner(storeId) || (
          isActiveStoreMember(storeId) && resource.data.cashierUid == request.auth.uid
        );
        allow create: if isValidId(transactionId) &&
                         (isStoreOwner(storeId) || isActiveStoreMember(storeId)) &&
                         incoming().cashierUid == request.auth.uid &&
                         incoming().keys().hasAll(['invoiceNumber', 'timestampMillis', 'dateKey', 'totalItems', 'totalRevenue', 'discountAmount', 'finalRevenue', 'totalCost', 'netProfit', 'paymentMethod', 'amountPaid', 'changeAmount', 'cashierUid', 'cashierName', 'cashierRole', 'createdAt']) &&
                         incoming().keys().hasOnly(['invoiceNumber', 'timestampMillis', 'dateKey', 'totalItems', 'totalRevenue', 'discountAmount', 'finalRevenue', 'totalCost', 'netProfit', 'paymentMethod', 'amountPaid', 'changeAmount', 'cashierUid', 'cashierName', 'cashierRole', 'customerName', 'notes', 'qrisReference', 'createdAt']) &&
                         isValidSaleTransaction(incoming());
        allow update, delete: if false;
      }

      // Store Sale Items (Append-only; Owner reads all for daily profit reporting, Kasir reads own only)
      match /sale_items/{saleItemId} {
        allow get: if isValidId(saleItemId) && (
          isStoreOwner(storeId) ||
          (isActiveStoreMember(storeId) && existing().cashierUid == request.auth.uid)
        );
        allow list: if isStoreOwner(storeId) || (
          isActiveStoreMember(storeId) && resource.data.cashierUid == request.auth.uid
        );
        allow create: if isValidId(saleItemId) &&
                         (isStoreOwner(storeId) || isActiveStoreMember(storeId)) &&
                         incoming().cashierUid == request.auth.uid &&
                         incoming().keys().hasAll(['transactionId', 'dateKey', 'timestampMillis', 'productId', 'skuCode', 'productName', 'categoryName', 'quantity', 'unitCostPrice', 'unitSellingPrice', 'subtotalRevenue', 'subtotalCost', 'subtotalProfit', 'cashierUid', 'createdAt']) &&
                         incoming().keys().hasOnly(['transactionId', 'dateKey', 'timestampMillis', 'productId', 'skuCode', 'productName', 'variantSummary', 'categoryName', 'quantity', 'unitCostPrice', 'unitSellingPrice', 'subtotalRevenue', 'subtotalCost', 'subtotalProfit', 'cashierUid', 'createdAt']) &&
                         isValidSaleItem(incoming());
        allow update, delete: if false;
      }

      // Stock Movement Histories (Append-only; Owner reads all; Kasir can log checkout sales & manual stock add/reduce)
      match /stock_histories/{historyId} {
        allow get, list: if isStoreOwner(storeId);
        allow create: if isValidId(historyId) &&
                         incoming().actorUid == request.auth.uid &&
                         incoming().keys().hasAll(['productId', 'productName', 'changeType', 'quantityDelta', 'stockAfter', 'unitCostAtChange', 'actorName', 'actorUid', 'timestampMillis', 'createdAt']) &&
                         incoming().keys().hasOnly(['productId', 'productName', 'changeType', 'quantityDelta', 'stockAfter', 'unitCostAtChange', 'actorName', 'actorUid', 'note', 'timestampMillis', 'createdAt']) &&
                         isValidStockHistory(incoming()) && (
                           isStoreOwner(storeId) ||
                           (isActiveStoreMember(storeId) && (
                             (incoming().changeType == 'PENJUALAN' && incoming().quantityDelta < 0) ||
                             (incoming().changeType == 'RESTOK' && incoming().quantityDelta > 0) ||
                             (incoming().changeType == 'KOREKSI' && incoming().quantityDelta != 0)
                           ))
                         );
        allow update, delete: if false;
      }
    }
  }
}
